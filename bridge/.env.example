# Serial port the Pico W2 is connected to (USB cable → COM port)
# Windows example: COM3   Linux: /dev/ttyUSB0   macOS: /dev/tty.usbmodem*
SERIAL_PORT=COM3
SERIAL_BAUD=115200

# Firebase service account
FIREBASE_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Multi-Pico support ────────────────────────────────────────────────────────
# Run a separate bridge.py instance for each Pico (each with its own .env).
# Give each a unique BRIDGE_ID, BRIDGE_HTTP_PORT, and ROOM_LABEL.
BRIDGE_ID=bridge-1
ROOM_LABEL=Room 1
BRIDGE_HTTP_PORT=5050

# How many seconds to suppress duplicate scans from the same finger
DUPLICATE_COOLDOWN=30

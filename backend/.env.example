PORT=4000

# Firebase service account
FIREBASE_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Default bridge URL (Pico W2 in Room 1)
BRIDGE_URL=http://localhost:5050

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Email (nodemailer) ────────────────────────────────────────────────────────
# Leave blank to disable email notifications entirely.
# Gmail example: use an App Password (not your main password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=yourschool@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM="AttendFP System" <yourschool@gmail.com>
